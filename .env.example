# Markus environment variables — copy to `~/.markus/.env` and fill in.
#
# This is the CANONICAL secrets file for every client (CLI, packaged desktop).
# A `.env` in the current working directory is still read for non-secret keys
# (developer convenience), but secrets are NEVER taken from it — a cloned repo
# must not be able to override your credentials.
#
# Override the data directory with MARKUS_HOME (default ~/.markus).
# MARKUS_HOME=
#
# ── Secrets ──────────────────────────────────────────────────────────────────
# If JWT_SECRET is unset, Markus generates a strong random secret on first run
# and persists it to ~/.markus/jwt-secret (mode 0600). Setting it here is
# recommended for production / multi-instance deployments so all processes share
# the same signing key.
JWT_SECRET=

# Initial password for the placeholder owner (admin@markus.local) created on a
# fresh instance. If unset, a random password is generated and printed once to
# the server console (and saved to ~/.markus/initial-admin-password). You will
# be prompted to set your own credentials during onboarding.
ADMIN_PASSWORD=

# Signing secret for the External Agent Gateway (OpenClaw). If unset, a random
# secret is generated and persisted to ~/.markus/gateway-secret.
GATEWAY_SECRET=

# Set to "false" to disable login entirely (NOT recommended — anyone reaching
# the port would be treated as owner).
AUTH_ENABLED=true

# ── LLM providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# SQLite path override (default: ~/.markus/data.db)
# DATABASE_URL=sqlite:/path/to/db